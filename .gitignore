# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.p12
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# secrets and local env — never commit these
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Next.js generated agent rule files
/AGENTS.md
